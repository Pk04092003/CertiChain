PORT=10000

# Resend email delivery
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=CertiChain <onboarding@resend.dev>

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/certichain?retryWrites=true&w=majority

# Public frontend URL used in emails and QR verification
FRONTEND_URL=https://your-certichain-domain.vercel.app
